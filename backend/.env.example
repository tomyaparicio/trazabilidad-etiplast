# ─── Railway Postgres ──────────────────────────────────────────────────────────
# En Railway: variable de referencia → ${{Postgres.DATABASE_URL}}
# En local: usar la URL pública de Railway (centerbeam.proxy.rlwy.net)
DATABASE_URL=postgresql://user:password@host:port/railway

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar-en-produccion

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Dominio del frontend en Vercel + localhost para desarrollo
ALLOWED_ORIGINS=https://tu-dominio.vercel.app,http://localhost:3000
