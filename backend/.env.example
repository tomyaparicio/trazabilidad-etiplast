# Base de datos Railway (PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host.railway.internal:5432/railway

# JWT — generá una clave segura con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS: URLs del frontend. OBLIGATORIO en producción.
# Ejemplo: https://erpetiplast.vercel.app
ALLOWED_ORIGINS=https://erpetiplast.vercel.app,http://localhost:3000,http://localhost:5173
